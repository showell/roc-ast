-- **ROC-AST, DOWNLOADED AND INSTALLED** where Shale may run it
-- (~/tools/roc-ast/bin/roc-ast, under the `tools` mount). The parser is
-- roc-lang/roc's at the commit roc-version names. The binary is built on
-- GitHub (.github/workflows/build.yml) and installed from its published
-- asset. The asset's URL and sha256 are `release`; the download is held to
-- the sha256 before anything is unpacked. Run from this checkout:
--   shale install.shale
--
-- **A NEW PIN OR FORMAT IS A NEW ASSET**: run the build workflow
-- (`gh workflow run build.yml -f ref=<ref>`), which builds it static for a
-- baseline CPU and tars `bin/roc-ast` as
-- `roc-ast-flat<N>-<pin>-linux-x86_64.tar.gz`, printing its sha256; publish
-- it as a release of showell/roc-ast under a new name (a published asset
-- never changes) and put its URL and sha256 in `release`.

const RELEASE = "release"

local version = trim(read("roc-version"))
local parts = split(version, "-")
local short = parts[#parts]

local url = ""
local sha = ""
for l in lines(read(RELEASE)) do
  if starts_with(l, "url ") then url = trim(sub(l, 5)) end
  if starts_with(l, "sha256 ") then sha = trim(sub(l, 8)) end
end
if url == "" or sha == "" then fail("roc-ast: " .. RELEASE .. " lacks its `url` or `sha256` line") end
if starts_with(url, "TODO") or starts_with(sha, "TODO") then
  fail("roc-ast: " .. RELEASE .. " holds a placeholder: publish the build workflow's asset and put its URL and sha256 there")
end
if find(url, "-" .. short .. "-") == nil then
  fail("roc-ast: roc-version pins Roc " .. short .. ", and " .. RELEASE .. "'s asset is not that pin's (" .. url .. "): publish the pin's asset")
end

if not exists("tools:roc-ast") then mkdir("tools:roc-ast") end
local dir = fresh_dir("tools:roc-ast", "download")
local tarball = real(dir) .. "/roc-ast.tar.gz"
must(run({"curl", "-fsSL", "-o", tarball, url}, {timeout_ms = 600000, tail = 20}))
local summed = must(run({"sha256sum", tarball}, {timeout_ms = 60000, tail = 2}))
local got = words(summed.out)[1]
if got ~= sha then
  remove_tree(dir)
  fail("roc-ast: the download's sha256 is " .. got .. ", not " .. RELEASE .. "'s " .. sha .. "; nothing installed")
end
must(run({"tar", "-xzf", tarball, "-C", real("tools:roc-ast")}, {timeout_ms = 60000, tail = 20}))
remove_tree(dir)
if not exists("tools:roc-ast/bin/roc-ast") then fail("roc-ast: the asset held no bin/roc-ast; nothing installed at ~/tools/roc-ast/bin/roc-ast") end
print("roc-ast: Roc " .. short .. "'s parser, installed at ~/tools/roc-ast/bin/roc-ast")
